# Copy this file to .env and fill in real values. Never commit .env itself.

# Local development — SQLite file relative to the project root.
# DATABASE_URL="file:./dev.db"

# Production (Railway) — mount a persistent Volume on the service, set its
# mount path to /data, then set this exact variable in the Railway dashboard
# (Service > Variables). Do not commit a real production value here.
DATABASE_URL="file:/data/prod.db"
