generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String   @default("{}") // JSON: { clients: "full", services: "read", ... }
  isSystem    Boolean  @default(false) // System roles (Administrateur, Employé) cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id          String        @id @default(cuid())
  username    String        @unique
  password    String
  name        String
  roleId      String?
  role        String        @default("EMPLOYEE") // DEPRECATED: kept for migration, use roleId instead
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  roleRelation  Role?        @relation(fields: [roleId], references: [id])
  appointments  Appointment[]
}

model Client {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  phone      String?
  email      String?
  address    String?
  remarks    String?  // allergies, preferences
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  invoices     Invoice[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int      // in minutes
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointmentServices AppointmentService[]
}

model Appointment {
  id          String   @id @default(cuid())
  clientId    String
  employeeId  String
  date        DateTime
  status      String   @default("PROGRAMME") // PROGRAMME, ANNULE, TERMINE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client     Client     @relation(fields: [clientId], references: [id])
  employee   User       @relation(fields: [employeeId], references: [id])
  services   AppointmentService[]

  invoice Invoice?
}

model AppointmentService {
  id            String   @id @default(cuid())
  appointmentId String
  serviceId     String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, serviceId])
}

model Invoice {
  id              String   @id @default(cuid())
  appointmentId   String   @unique
  clientId        String
  amount          Float
  status          String   @default("NON_PAYEE") // PAYEE, NON_PAYEE, PARTIELLEMENT_PAYEE
  paidAmount      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
}

model Purchase {
  id          String   @id @default(cuid())
  label       String
  supplier    String?
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  label       String
  category    String   // LOYER, ELECTRICITE, SALAIRES, FOURNITURES, AUTRE
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}